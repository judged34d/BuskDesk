<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BuskDesk.ViewModels"
        xmlns:model="using:BuskDesk.Model"
        xmlns:output="using:BuskDesk.Output"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="BuskDesk.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1400" Height="900"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Title="Busk Desk"
        Icon="/Assets/avalonia-logo.ico">

    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource BuskSurface}"
                BorderBrush="{DynamicResource BuskBorder}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="{Binding StatusLine}" Classes="muted" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="chip" Margin="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource BuskLive}" />
                        <TextBlock Text="{Binding OutputStatus}" FontSize="12" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding FramesLabel}" Classes="muted" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding VersionLabel}" Classes="muted" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="220"
                Background="{DynamicResource BuskSurface}"
                BorderBrush="{DynamicResource BuskBorder}"
                BorderThickness="0,0,1,0"
                Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="6,10,6,28" Spacing="2">
                    <TextBlock Text="BUSK" Classes="eyebrow" />
                    <TextBlock Text="Desk" Classes="brand" />
                    <TextBlock Text="Small shows · live light" Classes="muted" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="4,0,4,8">
                    <TextBlock Text="{Binding Toast}" Classes="muted" TextWrapping="Wrap" MinHeight="20" />
                    <Button Content="BLACKOUT"
                            Classes="danger"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ToggleBlackoutCommand}" />
                    <TextBlock Text="GRAND MASTER" Classes="section" Margin="0,8,0,0" />
                    <Slider Classes="master" Value="{Binding GrandMaster}" />
                    <TextBlock Text="{Binding GrandMaster, StringFormat={}{0:0}}"
                               Classes="muted" HorizontalAlignment="Right" />
                </StackPanel>

                <StackPanel Spacing="3">
                    <Button Content="Pult" Classes="nav" Classes.active="{Binding IsDesk}" Command="{Binding GoDeskCommand}" />
                    <Button Content="Szenen" Classes="nav" Classes.active="{Binding IsScenes}" Command="{Binding GoScenesCommand}" />
                    <Button Content="Patch" Classes="nav" Classes.active="{Binding IsPatch}" Command="{Binding GoPatchCommand}" />
                    <Button Content="Sonde" Classes="nav" Classes.active="{Binding IsProbe}" Command="{Binding GoProbeCommand}" />
                    <Button Content="Ausgang" Classes="nav" Classes.active="{Binding IsOutput}" Command="{Binding GoOutputCommand}" />
                    <Button Content="Assistent" Classes="nav" Classes.active="{Binding IsAssistant}" Command="{Binding GoAssistantCommand}" />
                    <Button Content="Titel" Classes="nav" Classes.active="{Binding IsTracks}" Command="{Binding GoTracksCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Padding="24" HorizontalScrollBarVisibility="Disabled">
            <Panel>
                <!-- DESK -->
                <StackPanel IsVisible="{Binding IsDesk}" Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="LIVE DESK" Classes="eyebrow" />
                        <TextBlock Text="Zwei-Preset-Pult" Classes="headline" />
                        <TextBlock Text="Preset A/B überblenden · Submaster speichern und hochziehen"
                                   Classes="muted" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,16,150,16,*,16,200">
                        <Border Classes="panel">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="PRESET A" Classes="section" Margin="0,0,0,14" />
                                <ItemsControl ItemsSource="{Binding PresetA}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FaderChannelViewModel">
                                            <StackPanel Width="46" Spacing="6">
                                                <Slider Classes="fader" Value="{Binding Value}" />
                                                <TextBlock Text="{Binding Role}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Value, StringFormat={}{0:0}}" Classes="muted" FontSize="11" TextAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="10">
                            <TextBlock Text="XFADE" Classes="section" HorizontalAlignment="Center" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Crossfade}" />
                            <TextBlock Text="A ··· B" Classes="muted" HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border Grid.Column="4" Classes="panel">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="PRESET B" Classes="section" Margin="0,0,0,14" />
                                <ItemsControl ItemsSource="{Binding PresetB}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FaderChannelViewModel">
                                            <StackPanel Width="46" Spacing="6">
                                                <Slider Classes="fader" Value="{Binding Value}" />
                                                <TextBlock Text="{Binding Role}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Value, StringFormat={}{0:0}}" Classes="muted" FontSize="11" TextAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="6" Classes="panel">
                            <StackPanel Spacing="10">
                                <TextBlock Text="SUBMASTER" Classes="section" />
                                <ItemsControl ItemsSource="{Binding Submasters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SubmasterViewModel">
                                            <Border Background="{DynamicResource BuskSurfaceRaised}"
                                                    CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <Button Grid.Column="1"
                                                                Content="Store"
                                                                Classes="ghost"
                                                                Padding="8,4"
                                                                FontSize="11"
                                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).StoreSubmasterCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                    <Slider Minimum="0" Maximum="255"
                                                            Value="{Binding Level}"
                                                            IsEnabled="{Binding HasContent}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- SCENES -->
                <StackPanel IsVisible="{Binding IsScenes}" Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
                    <StackPanel Spacing="4">
                        <TextBlock Text="SHOW" Classes="eyebrow" />
                        <TextBlock Text="Szenen" Classes="headline" />
                        <TextBlock Text="Aktuellen Look speichern und mit GO abrufen" Classes="muted" />
                    </StackPanel>
                    <Border Classes="panel">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox Width="260" Text="{Binding NewSceneName}" Watermark="Szenenname" />
                            <Button Content="Look speichern" Classes="primary" Command="{Binding CaptureSceneCommand}" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Scenes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:SceneLook">
                                <Border Classes="panel" Margin="0,0,0,10" Padding="16">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FadeMs, StringFormat=Fade {0} ms}" Classes="muted" FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="GO" Classes="live" Margin="0,0,8,0"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RecallSceneCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Content="Löschen" Classes="ghost"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteSceneCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- PATCH -->
                <StackPanel IsVisible="{Binding IsPatch}" Spacing="18" MaxWidth="960" HorizontalAlignment="Left">
                    <StackPanel Spacing="4">
                        <TextBlock Text="RIG" Classes="eyebrow" />
                        <TextBlock Text="Patch" Classes="headline" />
                        <TextBlock Text="Fixtures auf Adressen legen" Classes="muted" />
                    </StackPanel>
                    <Border Classes="panel">
                        <Grid ColumnDefinitions="2*,*,*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Text="Profil" Classes="muted" Margin="0,0,0,6" />
                            <TextBlock Grid.Column="1" Text="Start" Classes="muted" Margin="0,0,0,6" />
                            <TextBlock Grid.Column="2" Text="Name" Classes="muted" Margin="0,0,0,6" />
                            <ComboBox Grid.Row="1" ItemsSource="{Binding Definitions}"
                                      SelectedItem="{Binding SelectedDefinition}"
                                      Margin="0,0,10,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="model:FixtureDefinition">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="512"
                                           Value="{Binding PatchStartAddress}" Margin="0,0,10,0" />
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding PatchName}" Margin="0,0,10,0" Watermark="Anzeigename" />
                            <Button Grid.Row="1" Grid.Column="3" Content="Patchen" Classes="primary" Command="{Binding AddPatchCommand}" />
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Patch}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:PatchedFixture">
                                <Border Classes="panel" Margin="0,0,0,8" Padding="16">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Classes="muted"
                                                       Text="{Binding StartAddress, StringFormat=Adresse {0:D3}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Entfernen" Classes="ghost"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemovePatchCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- PROBE -->
                <StackPanel IsVisible="{Binding IsProbe}" Spacing="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="LEARN" Classes="eyebrow" />
                        <TextBlock Text="Sonde" Classes="headline" />
                        <TextBlock Text="Kanäle live fahren, Rollen vergeben, als Fixture speichern"
                                   Classes="muted" />
                    </StackPanel>
                    <Border Classes="panel">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Width="110" Spacing="4">
                                <TextBlock Text="Start" Classes="muted" FontSize="11" />
                                <NumericUpDown Minimum="1" Maximum="512" Value="{Binding ProbeStartAddress}" />
                            </StackPanel>
                            <StackPanel Width="110" Spacing="4">
                                <TextBlock Text="Kanäle" Classes="muted" FontSize="11" />
                                <NumericUpDown Minimum="1" Maximum="32" Value="{Binding ProbeChannelCount}" />
                            </StackPanel>
                            <Button Content="Sonde lösen" Classes="ghost" VerticalAlignment="Bottom"
                                    Command="{Binding ClearProbeCommand}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="panel">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ProbeChannels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FaderChannelViewModel">
                                        <Border Background="{DynamicResource BuskSurfaceRaised}"
                                                CornerRadius="12" Padding="10" Width="70"
                                                PointerPressed="ProbeChannel_OnPointerPressed">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding Label}" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
                                                <Slider Classes="fader" Height="150" Value="{Binding Value}" />
                                                <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold"
                                                           TextAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Value, StringFormat={}{0:0}}"
                                                           Classes="muted" FontSize="11" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Border Classes="panel">
                        <Grid ColumnDefinitions="*,*,*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0">
                            <TextBlock Text="Hersteller" Classes="muted" />
                            <TextBlock Grid.Column="1" Text="Modell" Classes="muted" />
                            <TextBlock Grid.Column="2" Text="Modus" Classes="muted" />
                            <TextBox Grid.Row="1" Text="{Binding FixtureManufacturer}" Margin="0,6,10,12" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FixtureModel}" Margin="0,6,10,12" />
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding FixtureMode}" Margin="0,6,10,12" />
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10">
                                <ComboBox Width="180" ItemsSource="{Binding AvailableRoles}"
                                          SelectedItem="{Binding SelectedProbeRole}" />
                                <Button Content="Rolle zuweisen" Classes="ghost" Command="{Binding AssignProbeRoleCommand}" />
                                <Button Content="Als Fixture speichern" Classes="primary" Command="{Binding SaveFixtureFromProbeCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- OUTPUT -->
                <StackPanel IsVisible="{Binding IsOutput}" Spacing="18" MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Spacing="4">
                        <TextBlock Text="HARDWARE" Classes="eyebrow" />
                        <TextBlock Text="Ausgang" Classes="headline" />
                        <TextBlock Text="Air2DMX = WLAN Art-Net · USB2DMX/Enttec = Pro-API · erweiterbar"
                                   Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Classes="panel">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Treiber / Plugin" Classes="section" />
                            <ComboBox ItemsSource="{Binding OutputOptions}"
                                      SelectedItem="{Binding SelectedOutput}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="output:OutputOption">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxWidth="560" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                                <StackPanel Spacing="6" Margin="0,0,10,0">
                                    <TextBlock Text="Art-Net Host / Air2DMX" Classes="muted" FontSize="11" />
                                    <TextBox Text="{Binding ArtNetHost}" Watermark="2.0.0.1" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="COM-Port (USB Pro)" Classes="muted" FontSize="11" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ComboBox ItemsSource="{Binding SerialPorts}"
                                                  SelectedItem="{Binding SerialPort}" />
                                        <Button Grid.Column="1" Content="↻" Classes="ghost" Margin="8,0,0,0"
                                                Command="{Binding RefreshPortsCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Button Content="Ausgang verbinden" Classes="primary"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"
                                    Command="{Binding ApplyOutputCommand}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="panel">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Air2DMX Schnellhilfe" Classes="section" />
                            <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="20">
                                1. WLAN „JMS_AIR2DMX_…“ verbinden (Passwort auf dem Gehäuse).
                                2. Optional Setup http://2.0.0.1 · Standalone/Hotspot.
                                3. Hier „Air2DMX“ wählen und verbinden — Busk Desk sendet Art-Net Universe 0.
                                USB am Air2DMX ist nur Strom, kein Datenprotokoll.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ASSISTANT / TRACKS placeholders -->
                <Border Classes="panel" IsVisible="{Binding IsAssistant}" MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Spacing="12">
                        <TextBlock Text="ASSISTANT" Classes="eyebrow" />
                        <TextBlock Text="Live &amp; Listen" Classes="headline" />
                        <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="22">
                            Nächste Ausbaustufe: WASAPI-Loopback, Mood-Modelle und Listen-Training.
                            Die Engine und der Ausgang sind bereit — Audio hängt sich an denselben Merge-Stack.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Classes="panel" IsVisible="{Binding IsTracks}" MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Spacing="12">
                        <TextBlock Text="LIBRARY" Classes="eyebrow" />
                        <TextBlock Text="Titel-Shows" Classes="headline" />
                        <TextBlock Classes="muted" TextWrapping="Wrap" LineHeight="22">
                            Spotify-Track-ID und lokale MP3/WAV-Hashes speichern hier später die vorbereiteten Shows.
                            Kern (Patch, Sonde, Pult, Szenen, Ausgang) ist bereits live.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Panel>
        </ScrollViewer>
    </DockPanel>
</Window>
